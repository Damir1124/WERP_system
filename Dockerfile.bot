# Образ для Telegram-бота WERP (tg_bot).
# Бот запускается с django.setup() (прямой ORM-доступ), поэтому образ
# содержит и Django-зависимости, и зависимости бота.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Системные зависимости:
# - libpq-dev — для psycopg2/psycopg (Django ORM)
# - build-essential, python3-dev, gcc, libffi-dev — компилятор для сборки
#   C-пакетов из исходников на slim-образе
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    build-essential \
    python3-dev \
    gcc \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Django-зависимости (проект) + зависимости бота
COPY requirements.txt .
COPY requirements_bot.txt .
RUN pip install --no-cache-dir -r requirements.txt -r requirements_bot.txt

# Код проекта (включая tg_bot/)
COPY . .

# Точка входа — __main__.py бота
CMD ["python", "-m", "tg_bot"]