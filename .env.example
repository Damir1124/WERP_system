# ============================================================================
# WERP / Osnova 2.0 — Продакшен-шаблон переменных окружения
# Копируй в `.env` на сервере:   cp .env.example .env
# Затем заполни реальные значения. Никогда не коммить `.env` в git!
# ============================================================================

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DEBUG=False

# ГЕНЕРАЦИЯ СЕКРЕТНОГО КЛЮЧА (сделай НОВЫЙ, не копируй из разработки):
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# ВАЖНО: если ключ содержит символ `$` — экранируй его как `$$` в .env,
# иначе docker compose попытается подставить переменную (ошибка "The x
# variable is not set").
DJANGO_SECRET_KEY=

# Разрешённые домены через запятую (без http://). Только реальный домен!
# Пример: ALLOWED_HOSTS=werp.uz,www.werp.uz
ALLOWED_HOSTS=

# Домен хостинга Mini App для CORS (без trailing slash).
# Пример: CORS_ALLOWED_ORIGINS=https://werp.uz
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# База данных PostgreSQL
# ---------------------------------------------------------------------------
DB_NAME=werp_system
DB_USER=werp_admin
DB_PASSWORD=
DB_HOST=db              # имя сервиса в docker-compose (внутри сети), не localhost
DB_PORT=5432

# ---------------------------------------------------------------------------
# Redis (кэш, Channels, Celery) — db 0/1/2 раздельно
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------------------------------------------------------------------------
# Telegram-бот
# ---------------------------------------------------------------------------
# Токен от @BotFather
BOT_TOKEN=

# В продакшене ОБЯЗАТЕЛЬНО webhook, НЕ polling:
USE_WEBHOOK=true
# Webhook URL на твоём домене (внутри Nginx — SamePath; снаружи — домен)
WEBHOOK_HOST=https://werp.uz
WEBHOOK_PATH=/webhook
# Хост/порт для встроенного aiohttp-сервера бота (внутри контейнера бота)
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8001

# URL Django API, который видит бот (внутри docker-сети — имя сервиса)
DJANGO_API_URL=http://web:8000/api/bot

# URL Mini App (реальный домен)
MINI_APP_URL=https://werp.uz/static/miniapp

# Telegram ID администраторов через запятую
ADMIN_IDS=

# Дополнительный чат для отчётов закрытия рейсов/смен (опционально)
ADMIN_CHAT_ID=

# ---------------------------------------------------------------------------
# Безопасность интеграции с Telegram (в продакшене — строго True)
# ---------------------------------------------------------------------------
BOT_BRIDGE_REQUIRE_TG_HEADER=True
BOT_BRIDGE_VERIFY_INIT_DATA=True
# Если хочешь хранить BOT_TOKEN также в Django (необязательно при наличии
# BOT_TOKEN выше) — оставь пустым.
# TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# SSL/HTTPS (включаются автоматически при DEBUG=False)
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------------
# Логирование
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# ПРОЧИЕ (для полноты; значения по умолчанию подходят)
# ---------------------------------------------------------------------------
# порт aiohttp бота НЕ конфликтует с Gunicorn/Uvicorn (см. compose):
# WEBAPP_PORT=8001 используется ботом, за NAT nginx не обязателен.